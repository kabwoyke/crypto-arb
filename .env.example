# Copy to .env for local dev. Never commit real credentials.
# Modes: paper (no orders) | shadow (compute + log) | live (needs LIVE_ENABLED + per-client allow-flag)
ENGINE_MODE=paper
LIVE_ENABLED=false

POSTGRES_USER=oddtrue
POSTGRES_PASSWORD=oddtrue_dev_only
POSTGRES_DB=oddtrue
POSTGRES_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgresql+psycopg://oddtrue:oddtrue_dev_only@localhost:5433/oddtrue
REDIS_URL=redis://localhost:6380/0
